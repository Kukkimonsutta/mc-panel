# Host path containing minecraft_data/, backups/, and docker-compose.yml
MINECRAFT_ROOT=/home/kukkimonsuta/docker/minecraft

# Published panel port
PANEL_PORT=8081

# Must match the Minecraft container RCON configuration
RCON_PASSWORD=change-this-password
RCON_HOST=minecraft-server
RCON_PORT=25575
TARGET_CONTAINER_NAME=minecraft-server
# Host used for Minecraft status/query probes (use minecraft-server inside Docker)
MC_HOST=minecraft-server
MC_STATUS_PORT=25565
MC_QUERY_PORT=25565

# Strong token shared by backend and frontend build
API_TOKEN=change-this-panel-token

# Docker socket group on the host: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=988

# Same-origin frontend normally makes this unnecessary, but keep it restricted
CORS_ORIGIN=http://localhost:8081
MINECRAFT_NETWORK=stark_net

# Optional backup behavior
ALLOW_UNSAFE_BACKUP=0
ENABLE_BACKUP_DOWNLOAD=1

# Scheduled backups — initial defaults only; the panel UI can override these at
# runtime (persisted as a JSON file inside the backups folder)
BACKUP_SCHEDULE_ENABLED=0
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=10  # keep last N backups (0 = unlimited)
