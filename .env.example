# ============================================================
# MC Control Panel — Docker Compose environment
# Copy this file to `.env` and fill in every value below.
# `.env` contains secrets: it is git-ignored and must stay private.
# ============================================================

# --- REQUIRED -----------------------------------------------------------

# Absolute host path to your Minecraft Compose stack directory.
# It must contain: minecraft_data/ (with server.properties), backups/, and docker-compose.yml
MINECRAFT_ROOT=/path/to/your/minecraft/stack

# Name of the external Docker network that your Minecraft stack is attached to.
# Create it first with: docker network create <name>
MINECRAFT_NETWORK=minecraft_net

# Must match the RCON password of your Minecraft server (server.properties: rcon.password)
RCON_PASSWORD=change-this-password

# Strong random token that protects the panel API (backend + frontend build).
# Generate one with: openssl rand -hex 32
API_TOKEN=change-this-panel-token

# --- OPTIONAL (sensible defaults provided) ------------------------------

# Host port where the panel web UI is published
PANEL_PORT=8081

# Name of your Minecraft server container (as defined in its Compose file)
TARGET_CONTAINER_NAME=minecraft-server

# Host used for status/query probes and RCON, as seen from the panel container
MC_HOST=minecraft-server
RCON_HOST=minecraft-server
RCON_PORT=25575
MC_STATUS_PORT=25565
MC_QUERY_PORT=25565

# Group ID of the Docker socket on the host:  stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

# Origin allowed for CORS (same-origin frontend usually makes this unnecessary;
# keep it restricted in production)
CORS_ORIGIN=http://localhost:8081

# Backup behavior
ALLOW_UNSAFE_BACKUP=0
ENABLE_BACKUP_DOWNLOAD=1

# Scheduled backups — initial defaults only; the panel UI can override these
# at runtime (persisted as a JSON file inside the backups folder)
BACKUP_SCHEDULE_ENABLED=0
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=10
