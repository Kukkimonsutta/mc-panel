# MC Panel Backend Configuration
# Copy this file to .env and adjust values as needed.
# Defaults in config.js are compatible with the existing setup.

# Server port (default 3005)
PORT=3005

# Minecraft server ports for status/query (both default to 25565)
MC_STATUS_PORT=25565
MC_QUERY_PORT=25565

# Docker configuration
DOCKER_SOCKET=/var/run/docker.sock
TARGET_CONTAINER_NAME=minecraft-server

# RCON configuration (for sending commands and coordinating backups)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=1234@4321

# Host filesystem paths (where the Minecraft data is bind-mounted)
HOST_DATA_DIR=/home/kukkimonsuta/docker/minecraft/minecraft_data
HOST_COMPOSE_FILE=/home/kukkimonsuta/docker/minecraft/docker-compose.yml
BACKUP_DIR=/home/kukkimonsuta/docker/minecraft/backups

# API authentication (optional, leave unset for open API with warning)
# Set this to a strong random string to require Bearer token auth on all /api/* endpoints
# API_TOKEN=your-secret-token-here

# CORS configuration (restrict in production)
CORS_ORIGIN=*

# Backup safety (default: false, requires successful save-off before backup)
# Set to 1 to allow backups even if save-off fails (not recommended)
# ALLOW_UNSAFE_BACKUP=0

# Backup download feature (default: enabled)
# ENABLE_BACKUP_DOWNLOAD=1
