# MC Panel Frontend Configuration
# This file shows available Vite environment variables.
# Copy to `.env.local` to override at build-time or dev-time.

# Backend API URL (leave unset for relative URLs / Vite dev proxy).
# In development with Vite, /api/* routes are proxied to http://localhost:3005.
# In production, set this to your backend URL only if the API is NOT served
# from the same origin as the frontend.
# VITE_API_URL=http://your-backend-host:3005

# Backend API token (if API_TOKEN is set on the backend).
# Sent as Authorization: Bearer <token> header on all API requests.
# In Docker this is injected at build time from the root .env API_TOKEN.
# VITE_API_TOKEN=your-secret-token-here
