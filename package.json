{
  "name": "mc-panel",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix name \"npm --prefix backend run dev\" \"npm --prefix frontend run dev -- --host 0.0.0.0\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "socket.io-client": "^4.8.3"
  }
}
